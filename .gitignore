# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
.vite/

# Electron-builder staging
apps/scelo-ide/resources/renderer/
apps/scelo-ide/resources/runtime/
# Bundled swarm (compiled server + built client) — regenerated by
